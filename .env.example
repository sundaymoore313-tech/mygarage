# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Stripe-hosted billing links.
# Create these in Stripe Dashboard after you create your product/price.
VITE_STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-checkout-link
VITE_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/your-portal-link
VITE_BILLING_SUPPORT_EMAIL=billing@yourdomain.com

# Google AdSense Auto Ads (optional)
# Example: ca-pub-1234567890123456
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-your-publisher-id

# Discord community link used by the homepage button.
# Set this to a non-expiring invite (Server Settings -> Invites -> Edit Invite Link -> Expire After: Never).
VITE_DISCORD_PERMANENT_INVITE_URL=https://discord.gg/your-permanent-invite
