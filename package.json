{
  "name": "mygarage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:assets": "node scripts/generate-decals-manifest.mjs && node scripts/generate-cars-manifest.mjs && node scripts/generate-fonts-manifest.mjs && node scripts/generate-prints-manifest.mjs",
    "predev": "npm run generate:assets",
    "dev": "vite",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "backend:db:push": "supabase db push",
    "backend:functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "backend:functions:deploy:checkout": "supabase functions deploy create-stripe-checkout-session",
    "backend:functions:deploy:portal": "supabase functions deploy create-stripe-portal-session",
    "backend:functions:deploy:webhook": "supabase functions deploy stripe-webhook",
    "backend:functions:deploy:feedback": "supabase functions deploy submit-feedback",
    "backend:functions:deploy:all": "npm run backend:functions:deploy:checkout && npm run backend:functions:deploy:portal && npm run backend:functions:deploy:webhook && npm run backend:functions:deploy:feedback",
    "prebuild": "npm run generate:assets",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.1",
    "@types/paper": "^0.11.14",
    "@vercel/speed-insights": "^2.0.0",
    "clipper-lib": "^6.4.2",
    "jspdf": "^4.2.1",
    "konva": "^10.3.0",
    "leva": "^0.10.1",
    "lucide-react": "^1.14.0",
    "opentype.js": "^1.3.5",
    "paper": "^0.12.18",
    "paperjs-offset": "^1.0.8",
    "react": "^19.2.5",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.5",
    "react-konva": "^19.2.3",
    "three": "^0.184.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^27.0.1",
    "supabase": "^2.98.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
